# AI Smart Camera Environment Configuration
# Application host and port
APP_HOST=0.0.0.0
APP_PORT=7860
GRADIO_SHARE=false

# Model Configuration
# Available model names: yolov8n, yolo11n, yolov8s
MODEL_NAME=yolov8n
MODEL_CACHE_DIR=./models/weights
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=cpu # 'cpu', 'cuda', 'cuda:0', 'mps'

# Video / Camera Stream Configuration
CAMERA_STREAM_FPS=10
FRAME_SKIP_INTERVAL=1
IMAGE_MAX_SIZE=1280

# Logging
LOG_LEVEL=INFO
